{
  "name": "loopboard",
  "packageManager": "pnpm@11.1.1",
  "version": "0.1.0",
  "description": "A local, Linear-like board for the markdown issues, PRDs and specs that you and your coding agents keep in .agents/.",
  "keywords": [
    "kanban",
    "issue-tracker",
    "markdown",
    "prd",
    "ai-agents",
    "claude-code",
    "cursor",
    "codex"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "loopboard": "bin/loopboard.js"
  },
  "files": [
    "bin",
    "build",
    "scaffold",
    ".agents/skills",
    ".agents/issues/README.md",
    ".agents/issues/_templates",
    ".agents/projects/README.md",
    ".agents/projects/_templates",
    "LICENSE",
    "README.md",
    "CREDITS.md",
    "MIGRATIONS.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && pnpm build:app",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint:fix": "vue-tsc --noEmit",
    "verify": "vue-tsc --noEmit && vitest run && node scripts/contrast.mjs",
    "start": "node bin/loopboard.js",
    "contrast": "node scripts/contrast.mjs",
    "smoke": "node scripts/smoke.mjs",
    "demo": "node scripts/demo/record.mjs",
    "prepublishOnly": "pnpm build && pnpm verify",
    "build:app": "vite build && vite build --ssr server/cli.ts --outDir build/server"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lucide/vue": "^1.51.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/vue-3": "^3.31.4",
    "gray-matter": "^4.0.3",
    "marked": "^14.1.3",
    "vue": "^3.5.18",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@vitejs/plugin-vue": "^5.1.4",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "typescript": "^5.8.3",
    "vite": "^5.4.10",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.1.10"
  }
}
